<refentry xml:id="cachingiterator.offsetunset" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::offsetUnset</refname>
  <refpurpose>Remove an element from the cache</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>void</type><methodname>CachingIterator::offsetUnset</methodname>
   <methodparam><type>string</type><parameter>key</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Removes the element stored under <parameter>key</parameter> from the cache.
   This method is called when <function>unset</function> is used on the
   <classname>CachingIterator</classname> with array syntax, such as
   <code>unset($iterator['key'])</code>.
   The inner iterator is not modified.
  </simpara>
  <simpara>
   The <constant>CachingIterator::FULL_CACHE</constant> flag must be set.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>key</parameter></term>
    <listitem>
     <simpara>
      The key of the element to be removed.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Throws a <exceptionname>BadMethodCallException</exceptionname> if the
   <constant>CachingIterator::FULL_CACHE</constant> flag is not set.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::offsetExists</methodname></member>
   <member><methodname>CachingIterator::offsetSet</methodname></member>
   <member><methodname>CachingIterator::getCache</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
