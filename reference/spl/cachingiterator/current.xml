<refentry xml:id="cachingiterator.current" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::current</refname>
  <refpurpose>Return the current element</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>mixed</type><methodname>CachingIterator::current</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Returns the current element.
  </simpara>
  <simpara>
   As the <classname>CachingIterator</classname> is one element ahead of its
   inner iterator, this is the element that was stored when the iterator last
   moved, not the current element of the inner iterator.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Returns the current element, or &null; if the iterator is not
   <link linkend="cachingiterator.valid">valid</link>.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::key</methodname></member>
   <member><methodname>CachingIterator::valid</methodname></member>
   <member><methodname>Iterator::current</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

