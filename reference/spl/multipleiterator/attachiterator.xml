<refentry xml:id="multipleiterator.attachiterator" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::attachIterator</refname>
  <refpurpose>Attaches iterator information</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>void</type><methodname>MultipleIterator::attachIterator</methodname>
   <methodparam><type>Iterator</type><parameter>iterator</parameter></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>int</type><type>null</type></type><parameter>info</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Attaches an iterator, together with its associated information. Attached
   iterators are iterated over in the order in which they were attached.
  </simpara>
  <simpara>
   If <parameter>iterator</parameter> is already attached, its associated
   information is replaced with <parameter>info</parameter>, unless
   <parameter>info</parameter> is identical to the information it already has.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>iterator</parameter></term>
    <listitem>
     <simpara>
      The new iterator to attach.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>info</parameter></term>
    <listitem>
     <simpara>
      The associated information for the iterator, which must be an
      <type>int</type>, a <type>string</type>, or &null;. With
      <constant>MultipleIterator::MIT_KEYS_ASSOC</constant>, it is used as the
      key of the iterator's values in the arrays returned by
      <methodname>MultipleIterator::current</methodname> and
      <methodname>MultipleIterator::key</methodname>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Throws an <exceptionname>InvalidArgumentException</exceptionname> if
   <parameter>info</parameter> is not &null; and is identical to the
   information associated with an iterator that is already attached.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>MultipleIterator::detachIterator</methodname></member>
   <member><methodname>MultipleIterator::containsIterator</methodname></member>
   <member><methodname>MultipleIterator::__construct</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
