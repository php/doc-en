<refentry xml:id="multipleiterator.valid" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::valid</refname>
  <refpurpose>Checks the validity of sub iterators</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>bool</type><methodname>MultipleIterator::valid</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Checks the validity of the attached iterators. With
   <constant>MultipleIterator::MIT_NEED_ALL</constant>, all of them must be
   valid; with <constant>MultipleIterator::MIT_NEED_ANY</constant>, at least
   one of them must be valid.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Returns &true; if all attached iterators are valid
   (<constant>MultipleIterator::MIT_NEED_ALL</constant>) or at least one is
   valid (<constant>MultipleIterator::MIT_NEED_ANY</constant>), otherwise
   &false;. If no iterator is attached, &false; is returned.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>MultipleIterator::__construct</methodname></member>
   <member><methodname>MultipleIterator::setFlags</methodname></member>
   <member><methodname>MultipleIterator::current</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
