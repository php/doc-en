<refentry xml:id="multipleiterator.setflags" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::setFlags</refname>
  <refpurpose>Sets flags</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>void</type><methodname>MultipleIterator::setFlags</methodname>
   <methodparam><type>int</type><parameter>flags</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Replaces the flags that control how the attached iterators are iterated
   over.
  </simpara>
  <simpara>
   As <constant>MultipleIterator::MIT_NEED_ANY</constant> and
   <constant>MultipleIterator::MIT_KEYS_NUMERIC</constant> are
   <literal>0</literal>, a flag that is not given falls back to them: for
   example, passing only <constant>MultipleIterator::MIT_KEYS_ASSOC</constant>
   also switches the iterator to
   <constant>MultipleIterator::MIT_NEED_ANY</constant>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>flags</parameter></term>
    <listitem>
     <simpara>
      A bitmask of the
      <link linkend="multipleiterator.constants">MultipleIterator
      constants</link>: <constant>MultipleIterator::MIT_NEED_ALL</constant> or
      <constant>MultipleIterator::MIT_NEED_ANY</constant>, combined with
      <constant>MultipleIterator::MIT_KEYS_NUMERIC</constant> or
      <constant>MultipleIterator::MIT_KEYS_ASSOC</constant>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><link linkend="multipleiterator.constants">Flag Constants</link></member>
   <member><methodname>MultipleIterator::__construct</methodname></member>
   <member><methodname>MultipleIterator::getFlags</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
