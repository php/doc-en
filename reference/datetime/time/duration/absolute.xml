<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="time-duration.absolute" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::absolute</refname>
  <refpurpose>Returns the absolute value of the duration</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>Time\Duration</type><methodname>Time\Duration::absolute</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Returns the absolute value of the duration, that is, a duration with the
   same <property>Time\Duration::$seconds</property> and
   <property>Time\Duration::$nanoseconds</property> values whose
   <property>Time\Duration::$negative</property> property is &false;.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Returns a non-negative <classname>Time\Duration</classname> object.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.absolute.example.basic">
   <title><methodname>Time\Duration::absolute</methodname> example</title>
   <programlisting role="php">
<![CDATA[
<?php
$difference = \Time\Duration::fromSeconds(10)->sub(\Time\Duration::fromSeconds(25));

var_dump($difference->negative);
var_dump($difference->absolute());
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
bool(true)
object(Time\Duration)#1 (3) {
  ["seconds"]=>
  int(15)
  ["nanoseconds"]=>
  int(0)
  ["negative"]=>
  bool(false)
}
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::negate</methodname></member>
   <member><methodname>Time\Duration::sub</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
