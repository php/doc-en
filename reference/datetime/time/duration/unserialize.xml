<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="time-duration.unserialize" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::__unserialize</refname>
  <refpurpose>Restores a duration from serialized data</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>void</type><methodname>Time\Duration::__unserialize</methodname>
   <methodparam><type>array</type><parameter>data</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Deserializes the &array; from the <parameter>data</parameter> parameter
   into a <classname>Time\Duration</classname> object.
   This method is called by <function>unserialize</function> and is not
   meant to be called directly.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>data</parameter></term>
    <listitem>
     <simpara>
      The serialized data as an <type>array</type>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   If <parameter>data</parameter> does not describe a valid duration, an
   <exceptionname>Exception</exceptionname> is thrown.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>serialize</function></member>
   <member><function>unserialize</function></member>
   <member><link linkend="language.oop5.magic">Magic Methods</link></member>
  </simplelist>
 </refsect1>

</refentry>
