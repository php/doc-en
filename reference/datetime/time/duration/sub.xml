<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="time-duration.sub" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::sub</refname>
  <refpurpose>Subtracts a duration</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <type>Time\Duration</type><methodname>Time\Duration::sub</methodname>
   <methodparam><type>Time\Duration</type><parameter>duration</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Returns the difference between this duration and
   <parameter>duration</parameter>.
   If <parameter>duration</parameter> is longer than this duration, the
   result is negative.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>duration</parameter></term>
    <listitem>
     <simpara>
      The duration to subtract.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Returns a new <classname>Time\Duration</classname> object.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   A <exceptionname>Time\TimeException</exceptionname> is thrown if the
   resulting duration exceeds the
   <link linkend="time-duration.intro">maximum length of a duration</link>.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.sub.example.basic">
   <title><methodname>Time\Duration::sub</methodname> example</title>
   <programlisting role="php">
<![CDATA[
<?php
var_dump(Time\Duration::fromSeconds(10)->sub(Time\Duration::fromMilliseconds(2500)));

// Subtracting a larger duration results in a negative duration.
var_dump(Time\Duration::fromSeconds(1)->sub(Time\Duration::fromSeconds(3)));
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
object(Time\Duration)#3 (3) {
  ["seconds"]=>
  int(7)
  ["nanoseconds"]=>
  int(500000000)
  ["negative"]=>
  bool(false)
}
object(Time\Duration)#1 (3) {
  ["seconds"]=>
  int(2)
  ["nanoseconds"]=>
  int(0)
  ["negative"]=>
  bool(true)
}
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::add</methodname></member>
   <member><methodname>Time\Duration::negate</methodname></member>
   <member><methodname>Time\Duration::absolute</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
