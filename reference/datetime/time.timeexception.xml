<reference xml:id="class.time-timeexception" role="class" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xi="http://www.w3.org/2001/XInclude">
 <title>The Time\TimeException class</title>
 <titleabbrev>Time\TimeException</titleabbrev>

 <partintro>
  <section xml:id="time-timeexception.intro">
   &reftitle.intro;
   <simpara>
    The base exception for the <literal>Time</literal> namespace.
   </simpara>
   <simpara>
    A <exceptionname>Time\TimeException</exceptionname> is thrown when a
    <classname>Time\Duration</classname> cannot be represented, because its
    length would exceed the supported range, and when a string passed to
    <methodname>Time\Duration::fromIso8601DurationString</methodname> is not
    a valid <acronym>ISO</acronym> 8601 duration.
   </simpara>
  </section>

  <section xml:id="time-timeexception.synopsis">
   &reftitle.classsynopsis;

   <packagesynopsis>
    <package>Time</package>

    <classsynopsis class="class">
     <ooexception>
      <exceptionname>TimeException</exceptionname>
     </ooexception>

     <ooclass>
      <modifier>extends</modifier>
      <classname>Exception</classname>
     </ooclass>

     <classsynopsisinfo role="comment">&InheritedProperties;</classsynopsisinfo>
