  <variablelist>
   <title>HTML constants</title>
   <varlistentry xml:id="constant.dom-html-no-default-ns">
    <term>
     <constant>Dom\HTML_NO_DEFAULT_NS</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      This disables setting the namespace of elements during parsing when
      using <classname>Dom\HTMLDocument</classname>.
      This exists for backwards compatibility with
      <classname>DOMDocument</classname>.
     </simpara>
     <caution>
      <simpara>
       Some DOM methods depend on the <acronym>HTML</acronym> namespace
       being set.
       By using this parser option, the behaviour of those methods can be
       influenced.
      </simpara>
     </caution>
    </listitem>
   </varlistentry>
  </variablelist>
  <variablelist>
   <title><classname>DOMException</classname> / <classname>Dom\Exception</classname> constants</title>
   <varlistentry xml:id="constant.dom-php-err">
    <term>
     <constant>DOM_PHP_ERR</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      Error code not part of the DOM specification. Meant for PHP errors.
      Deprecated as of PHP 8.4.0 because this is no longer used.
      Prior to PHP 8.4.0, this was inconsistently used to indicate
      out-of-memory situations.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.dom-index-size-err">
    <term>
     <constant>DOM_INDEX_SIZE_ERR</constant>,
     <constant>Dom\INDEX_SIZE_ERR</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      If index or size is negative, or greater than the allowed value.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.domstring-size-err">
    <term>
     <constant>DOMSTRING_SIZE_ERR</constant>,
     <constant xml:id="constant.dom-string-size-err">Dom\STRING_SIZE_ERR</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      If the specified range of text does not fit into a
      <type>string</type>.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.dom-hierarchy-request-err">
    <term>
     <constant>DOM_HIERARCHY_REQUEST_ERR</constant>,
     <constant>Dom\HIERARCHY_REQUEST_ERR</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      If any node is inserted somewhere it doesn't belong
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.dom-wrong-document-err">
