 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="dom-parentnode.prepend.example.basic">
   <title><methodname>Dom\ParentNode::prepend</methodname> example</title>
   <programlisting role="php">
<![CDATA[
<?php
$dom = Dom\HTMLDocument::createFromString(
    '<!DOCTYPE html><body><ul id="list"><li>One</li></ul></body>',
    LIBXML_NOERROR
);

$list = $dom->getElementById('list');

$li = $dom->createElement('li');
$li->textContent = 'Minus One';
$list->prepend('Zero', $li);

echo $list->outerHTML, "\n";
?>
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
<ul id="list">Zero<li>Minus One</li><li>One</li></ul>
]]>
   </screen>
  </example>
 </refsect1>

