<?xml version="1.0" encoding="utf-8"?>
<reference xml:id="enum.streamerrormode" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>The StreamErrorMode Enum</title>
 <titleabbrev>StreamErrorMode</titleabbrev>

 <partintro>
  <section xml:id="enum.streamerrormode.intro">
   &reftitle.intro;
   <simpara>
    The <enumname>StreamErrorMode</enumname> enum specifies how the errors of
    a stream operation are reported. It is the value of the
    <link linkend="context.stream.error-mode"><parameter>error_mode</parameter></link>
    stream context option.
   </simpara>
  </section>

  <section xml:id="enum.streamerrormode.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>StreamErrorMode</enumname>

    <enumitem>
     <enumidentifier>Error</enumidentifier>
     <enumitemdescription>
      Errors are reported as diagnostics, such as <constant>E_WARNING</constant>.
      This is the default.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Exception</enumidentifier>
     <enumitemdescription>
      A <exceptionname>StreamException</exceptionname> is thrown for
      terminating errors.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Silent</enumidentifier>
     <enumitemdescription>
      Errors are not reported.
     </enumitemdescription>
    </enumitem>
   </enumsynopsis>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><enumname>StreamErrorStore</enumname></member>
    <member><xref linkend="context.stream"/></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>
 </partintro>
</reference>
