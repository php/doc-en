<?xml version="1.0" encoding="utf-8"?>
<reference xml:id="enum.streamerrorstore" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>The StreamErrorStore Enum</title>
 <titleabbrev>StreamErrorStore</titleabbrev>

 <partintro>
  <section xml:id="enum.streamerrorstore.intro">
   &reftitle.intro;
   <simpara>
    The <enumname>StreamErrorStore</enumname> enum specifies which errors of
    a stream operation are stored for retrieval with
    <function>stream_last_errors</function>. It is the value of the
    <link linkend="context.stream.error-store"><parameter>error_store</parameter></link>
    stream context option.
   </simpara>
  </section>

  <section xml:id="enum.streamerrorstore.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>StreamErrorStore</enumname>

    <enumitem>
     <enumidentifier>Auto</enumidentifier>
     <enumitemdescription>
      The stored errors depend on the error mode.
      This is the default.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>None</enumidentifier>
     <enumitemdescription>
      No errors are stored.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>NonTerminating</enumidentifier>
     <enumitemdescription>
      Only non-terminating errors are stored.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Terminating</enumidentifier>
     <enumitemdescription>
      Only terminating errors are stored.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>All</enumidentifier>
     <enumitemdescription>
      All errors are stored.
     </enumitemdescription>
    </enumitem>
   </enumsynopsis>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><enumname>StreamErrorMode</enumname></member>
    <member><function>stream_last_errors</function></member>
    <member><xref linkend="context.stream"/></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>
 </partintro>
</reference>
