<?xml version="1.0" encoding="utf-8"?>
<reference xml:id="class.streamerror" role="class" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xi="http://www.w3.org/2001/XInclude">

 <title>The StreamError class</title>
 <titleabbrev>StreamError</titleabbrev>

 <partintro>

  <section xml:id="streamerror.intro">
   &reftitle.intro;
   <simpara>
    A <exceptionname>StreamError</exceptionname> object describes a single error
    reported by a stream operation. Instances are created by PHP and
    are returned by <function>stream_last_errors</function> and
    <methodname>StreamException::getErrors</methodname>, and passed to the
    <link linkend="context.stream.error-handler"><parameter>error_handler</parameter></link>
    stream context option.
   </simpara>
  </section>

  <section xml:id="streamerror.synopsis">
   &reftitle.classsynopsis;

   <classsynopsis class="class">
    <ooclass>
     <modifier>final</modifier>
     <modifier>readonly</modifier>
     <classname>StreamError</classname>
    </ooclass>

    <classsynopsisinfo role="comment">&Properties;</classsynopsisinfo>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>StreamErrorCode</type>
     <varname linkend="streamerror.props.code">code</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>string</type>
     <varname linkend="streamerror.props.message">message</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>string</type>
     <varname linkend="streamerror.props.wrappername">wrapperName</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>int</type>
     <varname linkend="streamerror.props.severity">severity</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>bool</type>
     <varname linkend="streamerror.props.terminating">terminating</varname>
    </fieldsynopsis>
   </classsynopsis>
  </section>

  <section xml:id="streamerror.props">
   &reftitle.properties;
   <variablelist>
    <varlistentry xml:id="streamerror.props.code">
     <term><varname>code</varname></term>
     <listitem>
      <simpara>
       The <enumname>StreamErrorCode</enumname> case identifying the kind of error.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.message">
     <term><varname>message</varname></term>
     <listitem>
      <simpara>
       The error message. This is the text of the diagnostic that is emitted
       with <constant>StreamErrorMode::Error</constant>, without the function
       name prefix.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.wrappername">
     <term><varname>wrapperName</varname></term>
     <listitem>
      <simpara>
       The name of the stream wrapper that reported the error,
       for example <literal>plainfile</literal> for local files.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.severity">
     <term><varname>severity</varname></term>
     <listitem>
      <simpara>
       The level the error is reported with in
       <constant>StreamErrorMode::Error</constant> mode,
       as one of the <link linkend="errorfunc.constants.errorlevels"><constant>E_<replaceable>*</replaceable></constant></link>
       constants, such as <constant>E_WARNING</constant> or <constant>E_NOTICE</constant>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.terminating">
     <term><varname>terminating</varname></term>
     <listitem>
      <simpara>
       &true; if the error made the operation fail,
       &false; if the operation continued after reporting it.
      </simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><function>stream_last_errors</function></member>
    <member><methodname>StreamException::getErrors</methodname></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>

 </partintro>

</reference>
