<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="function.stream-clear-errors" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>stream_clear_errors</refname>
  <refpurpose>Discards the stored stream errors</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>void</type><methodname>stream_clear_errors</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Discards the errors that <function>stream_last_errors</function> would
   return.
  </simpara>
  <simpara>
   As stored errors are kept until another operation stores errors,
   clearing them before an operation makes it possible to tell afterwards
   whether that operation stored any.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="stream-clear-errors.example.basic">
   <title><function>stream_clear_errors</function> example</title>
   <programlisting role="php">
<![CDATA[
<?php
$context = stream_context_create([
    'stream' => [
        'error_mode' => StreamErrorMode::Silent,
    ],
]);

fopen('/nonexistent/file.txt', 'r', false, $context);
var_dump(count(stream_last_errors()));

stream_clear_errors();
var_dump(count(stream_last_errors()));
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
int(1)
int(0)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>stream_last_errors</function></member>
   <member><xref linkend="stream.errors"/></member>
  </simplelist>
 </refsect1>
</refentry>
