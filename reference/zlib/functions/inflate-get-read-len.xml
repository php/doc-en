<refentry xml:id="function.inflate-get-read-len" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>inflate_get_read_len</refname>
  <refpurpose>Get number of bytes read so far</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>int</type><methodname>inflate_get_read_len</methodname>
   <methodparam><type>InflateContext</type><parameter>context</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Returns the number of compressed bytes read so far from the current stream.
   The count is reset to <literal>0</literal> by the first call to
   <function>inflate_add</function> after the previous stream has ended.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>context</parameter></term>
    <listitem>
     <simpara>
      A context created with <function>inflate_init</function>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Returns the number of bytes read so far from the current stream.
  </simpara>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       <parameter>context</parameter> expects an <classname>InflateContext</classname>
       instance now; previously, a <type>resource</type> was expected.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

</refentry>
