<refentry xml:id="reflectionattribute.getname" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>ReflectionAttribute::getName</refname>
  <refpurpose>Gets the name of the attribute</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="ReflectionAttribute">
   <modifier>public</modifier> <type>string</type><methodname>ReflectionAttribute::getName</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Gets the name of the attribute.
  </simpara>
  <simpara>
   The name is resolved when the attribute is declared, using the imports and
   namespace in effect at that point. The returned name is the fully qualified
   class name of the attribute, without a leading backslash. The attribute class
   does not need to exist for the name to be returned.
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   The name of the attribute.
  </para>
 </refsect1>

</refentry>
