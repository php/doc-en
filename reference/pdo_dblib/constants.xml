<section xml:id="ref.pdo-dblib.constants" xmlns="http://docbook.org/ns/docbook">
 &reftitle.constants;
 &pdo.driver-constants;
 <warning>
  <simpara>
   The constants listed below have been <emphasis>DEPRECATED</emphasis>
   as of PHP 8.5.0. Use the corresponding <classname>Pdo\Dblib</classname>
   constants instead.
  </simpara>
 </warning>
 <variablelist>
  <varlistentry xml:id="pdo.constants.dblib-attr-connection-timeout">
   <term>
    <constant>PDO::DBLIB_ATTR_CONNECTION_TIMEOUT</constant>
     (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     &Alias; <constant>Pdo\Dblib::ATTR_CONNECTION_TIMEOUT</constant>.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="pdo.constants.dblib-attr-query-timeout">
