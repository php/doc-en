    <simpara>
     &Alias; <constant>Pdo\Dblib::ATTR_QUERY_TIMEOUT</constant>.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="pdo.constants.dblib-attr-stringify-uniqueidentifier">
   <term>
    <constant>PDO::DBLIB_ATTR_STRINGIFY_UNIQUEIDENTIFIER</constant>
     (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     &Alias; <constant>Pdo\Dblib::ATTR_STRINGIFY_UNIQUEIDENTIFIER</constant>.
    </simpara>
   </listitem>
  </varlistentry>
