<refentry xml:id="swoole-timer.set" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Swoole\Timer::set</refname>
  <refpurpose>Set timer-related parameters</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <modifier>static</modifier> <type>void</type><methodname>Swoole\Timer::set</methodname>
   <methodparam><type>array</type><parameter>settings</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Sets the options used by the timers of the current process.
  </simpara>

  <warning>
   <simpara>
    This method was deprecated in Swoole 4.6.0 and removed in Swoole 6.0.0.
    Use <function>swoole_async_set</function> instead.
   </simpara>
  </warning>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>settings</parameter></term>
    <listitem>
     <simpara>
      An associative array of options. Only <literal>enable_coroutine</literal>
      is recognised: when set to &false;, the timer callbacks are executed
      directly instead of inside a newly created coroutine.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>
</refentry>

