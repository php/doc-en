<refentry xml:id="yaf-request-abstract.getparams" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Request_Abstract::getParams</refname>
<refpurpose>Retrieve all parameters</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type class="union"><type>array</type><type>null</type></type><methodname>Yaf_Request_Abstract::getParams</methodname>
   <void />
  </methodsynopsis>
  <simpara>Retrieves all parameters from the request.</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>An array of all parameters, or &null; if none are set.</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Request_Abstract::getParams</methodname> example</title>
   <programlisting role="php">
<![CDATA[
<?php
class ProductController extends Yaf_Controller_Abstract
{
    public function viewAction()
    {
        // Assuming the request is /product/view/id/17/sort/price
        var_dump($this->getRequest()->getParams());
    }
}
?>]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
array(2) {
  ["id"]=>
  string(2) "17"
  ["sort"]=>
  string(5) "price"
}
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Request_Abstract::setParam</methodname></member>
   <member><methodname>Yaf_Request_Abstract::getParam</methodname></member>
   <member><methodname>Yaf_Request_Abstract::clearParams</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

