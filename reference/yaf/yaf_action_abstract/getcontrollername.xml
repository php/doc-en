<refentry xml:id="yaf-controller-abstract.getcontrollername" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Action_Abstract::getControllerName</refname>
  <refpurpose>Get controller name</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type class="union"><type>string</type><type>null</type></type><methodname>Yaf_Action_Abstract::getControllerName</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   Returns the name of the controller that owns this action.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   The controller name as a &string;, or &null; if it is not set.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Action_Abstract::getControllerName</methodname> example</title>
   <programlisting role="php">
<![CDATA[
<?php
class ListAction extends Yaf_Action_Abstract
{
    public function execute() {
        // the name of the controller that owns this action,
        // e.g. "Product" for a ProductController
        var_dump($this->getControllerName());
    }
}
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
string(7) "Product"
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><methodname>Yaf_Action_Abstract::getController</methodname></member>
    <member><methodname>Yaf_Controller_Abstract::getName</methodname></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

