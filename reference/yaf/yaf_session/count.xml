<refentry xml:id="yaf-session.count" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Session::count</refname>
<refpurpose>Count session entries</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>int</type><methodname>Yaf_Session::count</methodname>
   <void />
  </methodsynopsis>
  <simpara>Returns the number of entries in the session.</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>The number of session entries as an integer.</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Session::count</methodname> example</title>
   <programlisting role="php">
<![CDATA[
<?php
$session = Yaf_Session::getInstance();
$session->start();

$session->set("user_id", 42);
$session->set("cart_items", 3);

var_dump(count($session));
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
int(2)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Session::get</methodname></member>
   <member><methodname>Yaf_Session::has</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

