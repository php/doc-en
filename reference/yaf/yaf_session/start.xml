<refentry xml:id="yaf-session.start" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Session::start</refname>
<refpurpose>Start the session</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>Yaf_Session</type><methodname>Yaf_Session::start</methodname>
   <void />
  </methodsynopsis>
  <simpara>Starts the session if it has not been started yet. This calls PHP's native session start mechanism. Calling this method multiple times is safe.</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>Returns the <classname>Yaf_Session</classname> instance.</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Session::start</methodname> example</title>
   <programlisting role="php">
<![CDATA[
<?php
// typically done once per request, e.g. in a bootstrap
$session = Yaf_Session::getInstance();
$session->start();

$session->set("user_id", 42);
echo $session->get("user_id");
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Session::getInstance</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

