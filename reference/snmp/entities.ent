<?xml version="1.0" encoding="utf-8"?>
<!-- $Revision$ -->
<!--
    See `manual.xml` for XML namespaces defaults.
    Keep the lines under 79 columns, to make the process of manual
    translation easier, and to avoid wrap-around in some other contexts.
-->
<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.snmp.changelog.object-id-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Now throws a <exceptionname>ValueError</exceptionname> if
   <parameter>object_id</parameter> is an empty <type>array</type>.
   Previously, an <constant>E_WARNING</constant> was raised and &false;
   was returned.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.security-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Now throws a <exceptionname>ValueError</exceptionname> if
   <parameter>security_level</parameter> is not a valid security level, or
   if <parameter>auth_protocol</parameter> or
   <parameter>privacy_protocol</parameter> is not a supported protocol and
   <parameter>security_level</parameter> uses it.
   Previously, an <constant>E_WARNING</constant> was raised and &false;
   was returned.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror">
 <row>
  <entry>8.5.0</entry>
  <entry>
   Now throws a <exceptionname>ValueError</exceptionname> when
   <parameter>hostname</parameter> or <parameter>community</parameter>
   contains null bytes, when the hostname length is equal to or greater
   than 128 bytes, when <parameter>community</parameter> is empty, when
   the port is negative or greater than 65535, or when the timeout or
   retries values are lower than -1 or too large.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror.v3">
 <row>
  <entry>8.5.0</entry>
  <entry>
   Now throws a <exceptionname>ValueError</exceptionname> when
   <parameter>hostname</parameter> or <parameter>security_name</parameter>
   contains null bytes, when the hostname length is equal to or greater
   than 128 bytes, when <parameter>security_name</parameter> is empty, when
   the port is negative or greater than 65535, or when the timeout or
   retries values are lower than -1 or too large.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.set-type-errors">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Now throws a <exceptionname>TypeError</exceptionname> if
   <parameter>object_id</parameter> is a <type>string</type> and
   <parameter>type</parameter> or <parameter>value</parameter> is an
   <type>array</type>, and a <exceptionname>ValueError</exceptionname> if a
   type is not a single character.
   Previously, an <constant>E_WARNING</constant> was raised and &false;
   was returned.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.object-id-valueerror">
 <simpara>
  Throws a <exceptionname>ValueError</exceptionname> if
  <parameter>object_id</parameter> is an empty <type>array</type>.
 </simpara>
</entity>

<entity name="ext.snmp.security-valueerror">
 <simpara>
  Throws a <exceptionname>ValueError</exceptionname> if
  <parameter>security_level</parameter> is not a valid security level, or
  if <parameter>auth_protocol</parameter> or
  <parameter>privacy_protocol</parameter> is not a supported protocol and
  <parameter>security_level</parameter> uses it.
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror">
 <simpara>
  As of PHP 8.5.0, throws a <exceptionname>ValueError</exceptionname> if
  <parameter>hostname</parameter> or <parameter>community</parameter>
  contains null bytes, if <parameter>hostname</parameter> is 128 bytes or
  longer or contains a port that is not between 0 and 65535, if
  <parameter>community</parameter> is empty, or if
  <parameter>timeout</parameter> or <parameter>retries</parameter> is lower
  than <literal>-1</literal> or too large.
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror.v3">
 <simpara>
  As of PHP 8.5.0, throws a <exceptionname>ValueError</exceptionname> if
  <parameter>hostname</parameter> or <parameter>security_name</parameter>
  contains null bytes, if <parameter>hostname</parameter> is 128 bytes or
  longer or contains a port that is not between 0 and 65535, if
  <parameter>security_name</parameter> is empty, or if
  <parameter>timeout</parameter> or <parameter>retries</parameter> is lower
  than <literal>-1</literal> or too large.
 </simpara>
</entity>

<entity name="ext.snmp.set-type-errors">
 <simpara>
  Throws a <exceptionname>TypeError</exceptionname> if
  <parameter>object_id</parameter> is a <type>string</type> and
  <parameter>type</parameter> or <parameter>value</parameter> is an
  <type>array</type>.
  Throws a <exceptionname>ValueError</exceptionname> if
  <parameter>object_id</parameter> is a <type>string</type> and
  <parameter>type</parameter> is not a single character, or if
  <parameter>type</parameter> is an <type>array</type> and the type of an
  object ID is not a single character.
 </simpara>
</entity>

</entities>
