<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="function.snmp-set-mib-option" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>snmp_set_mib_option</refname>
  <refpurpose>Set an option for parsing <acronym>MIB</acronym> files</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>void</type><methodname>snmp_set_mib_option</methodname>
   <methodparam><type>Snmp\Mib</type><parameter>option</parameter></methodparam>
   <methodparam><type>bool</type><parameter>enable</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Enables or disables an option that controls how the
   Net-<acronym>SNMP</acronym> library parses <acronym>MIB</acronym> files.
   These options make it possible to read <acronym>MIB</acronym> files that
   do not strictly follow the <acronym>SMI</acronym> syntax.
  </simpara>
  <simpara>
   The options apply to the <acronym>MIB</acronym> files that are read
   afterwards: with <function>snmp_read_mib</function>, when the
   <acronym>MIB</acronym> tree is loaded again by
   <function>snmp_init_mib</function>, or when a module is loaded
   automatically from the <acronym>MIB</acronym> directories.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>option</parameter></term>
    <listitem>
     <simpara>
      The option to set. See <enumname>Snmp\Mib</enumname> for the available
      options.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>enable</parameter></term>
    <listitem>
     <simpara>
      Whether to enable the option.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Reading a <acronym>MIB</acronym> file that uses underscores in names</title>
   <programlisting role="php" annotations="non-interactive">
<![CDATA[
<?php

snmp_set_mib_option(Snmp\Mib::AllowUnderscores, true);
snmp_read_mib('/usr/share/snmp/mibs/VENDOR-MIB.txt');

?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>snmp_read_mib</function></member>
   <member><function>snmp_init_mib</function></member>
  </simplelist>
 </refsect1>
</refentry>
