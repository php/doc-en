<?xml version="1.0" encoding="utf-8"?>
<reference xml:id="enum.snmp-stringoutput" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>The Snmp\StringOutput Enum</title>
 <titleabbrev>Snmp\StringOutput</titleabbrev>

 <partintro>
  <section xml:id="enum.snmp-stringoutput.intro">
   &reftitle.intro;
   <simpara>
    The <enumname>Snmp\StringOutput</enumname> enum lists the formats in
    which the Net-<acronym>SNMP</acronym> library prints string values.
    It is accepted by <function>snmp_set_string_output_format</function> and
    <methodname>SNMP::setStringOutputFormat</methodname>.
   </simpara>
   <simpara>
    The format only applies to string values whose <acronym>MIB</acronym>
    object has no <literal>DISPLAY-HINT</literal>; values that have one are
    always printed according to it.
   </simpara>
  </section>

  <section xml:id="enum.snmp-stringoutput.synopsis">
   &reftitle.enumsynopsis;

   <packagesynopsis>
    <package>Snmp</package>

    <enumsynopsis>
     <enumname>StringOutput</enumname>

     <enumitem>
      <enumidentifier>Guess</enumidentifier>
      <enumitemdescription>
       Print the string as text if it is printable, and as a hexadecimal
       string otherwise. This is the default.
      </enumitemdescription>
     </enumitem>

     <enumitem>
      <enumidentifier>Ascii</enumidentifier>
      <enumitemdescription>
       Always print the string as text.
       Corresponds to the <literal>-Oa</literal> command-line option of
       Net-<acronym>SNMP</acronym>.
      </enumitemdescription>
     </enumitem>

     <enumitem>
      <enumidentifier>Hex</enumidentifier>
      <enumitemdescription>
       Always print the string as a hexadecimal string.
       Corresponds to the <literal>-Ox</literal> command-line option of
       Net-<acronym>SNMP</acronym>.
      </enumitemdescription>
     </enumitem>
    </enumsynopsis>
   </packagesynopsis>
  </section>

  <section xml:id="enum.snmp-stringoutput.seealso">
   &reftitle.seealso;
   <simplelist>
    <member><function>snmp_set_string_output_format</function></member>
    <member><methodname>SNMP::setStringOutputFormat</methodname></member>
    <member><enumname>Snmp\Output</enumname></member>
   </simplelist>
  </section>
 </partintro>
</reference>
