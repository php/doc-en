<?xml version="1.0" encoding="utf-8"?>
<reference xml:id="class.io-poll-handle" role="class" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xi="http://www.w3.org/2001/XInclude">
 <title>The Io\Poll\Handle interface</title>
 <titleabbrev>Io\Poll\Handle</titleabbrev>

 <partintro>
  <section xml:id="io-poll-handle.intro">
   &reftitle.intro;
   <simpara>
    Represents something an <classname>Io\Poll\Context</classname> can watch.
    The interface has no methods and only identifies the objects accepted by
    <methodname>Io\Poll\Context::add</methodname>.
   </simpara>
   <simpara>
    It cannot be implemented by userland classes; attempting to do so is a
    fatal error.
    <classname>StreamPollHandle</classname> is the implementation for streams.
   </simpara>
  </section>

  <section xml:id="io-poll-handle.synopsis">
   &reftitle.interfacesynopsis;

   <packagesynopsis>
    <package>Io\Poll</package>

    <classsynopsis class="interface">
     <oointerface>
      <interfacename>Handle</interfacename>
     </oointerface>
    </classsynopsis>
   </packagesynopsis>
  </section>
 </partintro>

</reference>
