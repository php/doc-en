<?xml version="1.0" encoding="utf-8"?>
<reference xml:id="enum.io-poll-backend" role="enum" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <title>The Io\Poll\Backend enum</title>
 <titleabbrev>Io\Poll\Backend</titleabbrev>

 <partintro>
  <section xml:id="enum.io-poll-backend.intro">
   &reftitle.intro;
   <simpara>
    The <enumname>Io\Poll\Backend</enumname> enum lists the polling mechanisms
    an <classname>Io\Poll\Context</classname> can use.
    Which of them are available depends on the operating system.
   </simpara>
   <simpara>
    In addition to its cases, the enum provides the
    <methodname>Io\Poll\Backend::getAvailableBackends</methodname>,
    <methodname>Io\Poll\Backend::isAvailable</methodname> and
    <methodname>Io\Poll\Backend::supportsEdgeTriggering</methodname> methods.
   </simpara>
  </section>

  <section xml:id="enum.io-poll-backend.synopsis">
   &reftitle.enumsynopsis;

   <packagesynopsis>
    <package>Io\Poll</package>

    <enumsynopsis>
     <enumname>Backend</enumname>

     <enumitem>
      <enumidentifier>Auto</enumidentifier>
      <enumitemdescription>
       Selects the most suitable backend available on the platform: event
       ports, kqueue or epoll if one of them is available, and otherwise
       <literal>WSAPoll</literal> on Windows and <literal>poll</literal>
       elsewhere.
       This is the default.
      </enumitemdescription>
     </enumitem>

     <enumitem>
      <enumidentifier>Poll</enumidentifier>
      <enumitemdescription>
       The <literal>poll</literal> system call, available on all platforms
       except Windows.
      </enumitemdescription>
     </enumitem>

     <enumitem>
      <enumidentifier>Epoll</enumidentifier>
      <enumitemdescription>
       The <literal>epoll</literal> interface of Linux.
      </enumitemdescription>
     </enumitem>

     <enumitem>
      <enumidentifier>Kqueue</enumidentifier>
      <enumitemdescription>
       The <literal>kqueue</literal> interface of macOS and the BSD systems.
      </enumitemdescription>
     </enumitem>

     <enumitem>
      <enumidentifier>EventPorts</enumidentifier>
      <enumitemdescription>
       The event ports of Solaris and illumos.
      </enumitemdescription>
     </enumitem>

     <enumitem>
      <enumidentifier>WSAPoll</enumidentifier>
      <enumitemdescription>
       The <literal>WSAPoll</literal> function of Windows.
      </enumitemdescription>
     </enumitem>
    </enumsynopsis>
   </packagesynopsis>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><methodname>Io\Poll\Context::__construct</methodname></member>
    <member><methodname>Io\Poll\Context::getBackend</methodname></member>
    <member><enumname>Io\Poll\Event</enumname></member>
   </simplelist>
  </section>
 </partintro>

 &reference.io.io.poll.entities.backend;

</reference>
