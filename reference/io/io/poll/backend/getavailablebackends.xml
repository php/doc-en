<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="io-poll-backend.getavailablebackends" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Io\Poll\Backend::getAvailableBackends</refname>
  <refpurpose>Returns the backends available on the platform</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Io\\Poll\\Backend">
   <modifier>public</modifier> <modifier>static</modifier> <type>array</type><methodname>Io\Poll\Backend::getAvailableBackends</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Returns the backends a <classname>Io\Poll\Context</classname> can be
   created with on the current platform.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Returns a list of <enumname>Io\Poll\Backend</enumname> cases.
   <constant>Io\Poll\Backend::Auto</constant> is never part of it.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="io-poll-backend.getavailablebackends.example.basic">
   <title><methodname>Io\Poll\Backend::getAvailableBackends</methodname> example</title>
   <programlisting role="php">
<![CDATA[
<?php
use Io\Poll\Backend;

foreach (Backend::getAvailableBackends() as $backend) {
    echo $backend->name, PHP_EOL;
}
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
Poll
Epoll
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Io\Poll\Backend::isAvailable</methodname></member>
   <member><methodname>Io\Poll\Context::__construct</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
