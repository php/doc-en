  <section xml:id="io-poll-failedpolloperationexception.examples">
   &reftitle.examples;
   <example xml:id="io-poll-failedpolloperationexception.examples.code">
    <title>Inspecting the reason of a failed operation</title>
    <programlisting role="php">
<![CDATA[
<?php
use Io\Poll\Backend;
use Io\Poll\Context;
use Io\Poll\Event;
use Io\Poll\FailedPollOperationException;

[$reader, $writer] = stream_socket_pair(STREAM_PF_UNIX, STREAM_SOCK_STREAM, STREAM_IPPROTO_IP);

// The poll backend does not support edge triggering.
$context = new Context(Backend::Poll);

try {
    $context->add(new StreamPollHandle($reader), [Event::Read, Event::EdgeTriggered]);
} catch (FailedPollOperationException $exception) {
    echo $exception::class, PHP_EOL;
    echo $exception->getMessage(), PHP_EOL;
    var_dump($exception->getCode() === FailedPollOperationException::ERROR_NOSUPPORT);
}
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
Io\Poll\FailedHandleAddException
Failed to add handle
bool(true)
]]>
    </screen>
   </example>
  </section>

