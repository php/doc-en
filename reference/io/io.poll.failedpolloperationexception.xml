    <varlistentry xml:id="io-poll-failedpolloperationexception.constants.error-interrupted">
     <term><constant>Io\Poll\FailedPollOperationException::ERROR_INTERRUPTED</constant></term>
     <listitem>
      <simpara>
       The operation was interrupted by a signal.
