    </varlistentry>
    <varlistentry xml:id="io-poll-failedpolloperationexception.constants.error-nomem">
     <term><constant>Io\Poll\FailedPollOperationException::ERROR_NOMEM</constant></term>
     <listitem>
      <simpara>
       Not enough memory was available.
