     </listitem>
    </varlistentry>
    <varlistentry xml:id="io-poll-failedpolloperationexception.constants.error-toobig">
     <term><constant>Io\Poll\FailedPollOperationException::ERROR_TOOBIG</constant></term>
     <listitem>
      <simpara>
