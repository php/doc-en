<sect1 xml:id="migration86.new-functions">
 <title>New Functions</title>

 <sect2 xml:id="migration86.new-functions.core">
  <title>Core</title>

  <simplelist>
   <!-- RFC: https://wiki.php.net/rfc/clamp_v2 -->
   <member>
    <function>clamp</function> returns the given value if in range, else
    returns the nearest bound.
   </member>
   <!-- RFC: https://wiki.php.net/rfc/stream_errors -->
   <member><function>stream_last_errors</function></member>
   <member><function>stream_clear_errors</function></member>
   <member><function>stream_socket_get_crypto_status</function></member>
  </simplelist>
 </sect2>

