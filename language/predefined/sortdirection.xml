<?xml version="1.0" encoding="utf-8"?>
<reference xml:id="enum.sortdirection" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>The SortDirection enum</title>
 <titleabbrev>SortDirection</titleabbrev>

 <partintro>
  <section xml:id="enum.sortdirection.intro">
   &reftitle.intro;
   <simpara>
    The <enumname>SortDirection</enumname> enum is used to specify the
    direction in which values are sorted.
   </simpara>
   <note>
    <simpara>
     As of PHP 8.6.0, none of the functions bundled with PHP accept a
     <enumname>SortDirection</enumname>. For example,
     <function>array_multisort</function> still expects
     <constant>SORT_ASC</constant> or <constant>SORT_DESC</constant>.
    </simpara>
   </note>
  </section>

  <section xml:id="enum.sortdirection.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>SortDirection</enumname>

    <enumitem>
     <enumidentifier>Ascending</enumidentifier>
    </enumitem>

    <enumitem>
     <enumidentifier>Descending</enumidentifier>
    </enumitem>
   </enumsynopsis>
  </section>

  <section xml:id="enum.sortdirection.examples">
   &reftitle.examples;
   <example>
    <title>Sorting names with <enumname>SortDirection</enumname></title>
    <programlisting role="php" annotations="non-interactive">
<![CDATA[
<?php

function sortNames(array $names, SortDirection $direction): array
{
    match ($direction) {
        SortDirection::Ascending => sort($names),
        SortDirection::Descending => rsort($names),
    };

    return $names;
}

$names = ['Charlie', 'Alice', 'Bob'];

print_r(sortNames($names, SortDirection::Descending));
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
Array
(
    [0] => Charlie
    [1] => Bob
    [2] => Alice
)
]]>
    </screen>
   </example>
  </section>

  <section xml:id="enum.sortdirection.seealso">
   &reftitle.seealso;
   <simplelist>
    <member><link linkend="array.sorting">Sorting Arrays</link></member>
    <member><link linkend="language.enumerations">Enumerations</link></member>
   </simplelist>
  </section>
 </partintro>
</reference>
