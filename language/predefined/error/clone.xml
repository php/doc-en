<refentry xml:id="error.clone" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Error::__clone</refname>
  <refpurpose>Clone the error</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Error">
   <modifier>private</modifier> <type>void</type><methodname>Error::__clone</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Errors do not support cloning; this method exists only to prevent it.
  </simpara>
  <warning>
   <simpara>
    Errors cannot be cloned, whether they are instances of
    <exceptionname>Error</exceptionname> or of a subclass.
    Attempting to <link linkend="language.oop5.cloning">clone</link> an
    error throws an <exceptionname>Error</exceptionname>, which may be
    caught.
   </simpara>
  </warning>
 </refsect1>
 
 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>
 
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   &return.void;
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Attempting to clone an error throws an <exceptionname>Error</exceptionname>
   with the following message:
   <literal>Trying to clone an uncloneable object of class <replaceable>ClassName</replaceable></literal>.
  </simpara>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.1.0</entry>
      <entry>
       <methodname>Error::__clone</methodname> is no longer final.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>
</refentry>
