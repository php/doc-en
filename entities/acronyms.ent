<?xml version="1.0" encoding="utf-8"?>
<!-- $Revision$ -->
<!--

This is a translatable XML Entity file.
See doc-base/scripts/text-entities.php for details.

Each acronym of the manual is defined here as an entity named
acronym.<term>, where <term> is the exact text used inside
<acronym> tags. PhD uses these entities to generate the expansion
tooltips of <acronym> tags.

All acronyms should be listed in alphabetical order.

-->

<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

